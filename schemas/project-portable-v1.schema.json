{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-portable-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "formatVersion",
    "name",
    "description",
    "tags",
    "isConfidential",
    "items"
  ],
  "properties": {
    "kind": {
      "const": "circle-space-project-portable"
    },
    "formatVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isConfidential": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "frame-layout"
          },
          "name": {
            "type": "string"
          },
          "data": {
            "$ref": "frame-layout-v1.schema.json"
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "channel-knowledge-v1.schema.json"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "items": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "knowledge"
      ],
      "properties": {
        "knowledge": {
          "minItems": 1
        }
      }
    }
  ],
  "description": "Runtime additionally checks the combined 100-item and 16 MiB limits, IDs, payload correspondence and confidentiality."
}
