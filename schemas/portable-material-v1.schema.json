{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/portable-material-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "isConfidential"
  ],
  "properties": {
    "overallComment": { "type": ["string", "null"], "maxLength": 1000 },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "venue",
        "frame-definition",
        "request-definition",
        "genre-styles",
        "block-styles"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "isConfidential": {
      "type": "boolean"
    },
    "definitions": {
      "anyOf": [
        {
          "$ref": "circle-space-project-v1.schema.json#/$defs/spaceDefinitionCatalog"
        },
        {
          "type": "null"
        }
      ]
    },
    "venue": {
      "$ref": "channel-knowledge-v1.schema.json#/properties/venue"
    },
    "credits": {
      "$ref": "circle-space-project-v1.schema.json#/$defs/personCredits"
    },
    "genreStyles": {
      "anyOf": [
        {
          "$ref": "circle-space-project-v1.schema.json#/properties/genreStyles"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockStyles": {
      "anyOf": [
        {
          "$ref": "circle-space-project-v1.schema.json#/properties/blockStyles"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "venue"
        },
        "venue": {
          "type": "object"
        },
        "definitions": {
          "type": "null"
        },
        "genreStyles": {
          "type": "null"
        },
        "blockStyles": {
          "type": "null"
        }
      },
      "required": [
        "venue"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "frame-definition"
        },
        "venue": {
          "type": "null"
        },
        "definitions": {
          "type": "object",
          "properties": {
            "requests": {
              "minItems": 0,
              "maxItems": 0
            },
            "types": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "genreStyles": {
          "type": "null"
        },
        "blockStyles": {
          "type": "null"
        }
      },
      "required": [
        "definitions"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "request-definition"
        },
        "venue": {
          "type": "null"
        },
        "definitions": {
          "type": "object",
          "properties": {
            "requests": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "genreStyles": {
          "type": "null"
        },
        "blockStyles": {
          "type": "null"
        }
      },
      "required": [
        "definitions"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "genre-styles"
        },
        "genreStyles": {
          "type": "array"
        },
        "venue": {
          "type": "null"
        },
        "definitions": {
          "type": "null"
        },
        "blockStyles": {
          "type": "null"
        }
      },
      "required": [
        "genreStyles"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "block-styles"
        },
        "blockStyles": {
          "type": "array"
        },
        "venue": {
          "type": "null"
        },
        "definitions": {
          "type": "null"
        },
        "genreStyles": {
          "type": "null"
        }
      },
      "required": [
        "blockStyles"
      ]
    }
  ],
  "description": "Runtime validates exact request dependencies, geometry, IDs and confidentiality propagation."
}
